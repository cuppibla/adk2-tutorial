# Workshop path — run the levels locally against the project your workshop
# credit paid for, instead of an AI Studio key.
#
#   1. Claim your credit at the link the instructor shared.
#   2. ./setup_billing.sh                        # creates adk-2-tutorial-XXXX, links the credit
#   3. gcloud services enable aiplatform.googleapis.com
#   4. gcloud auth application-default login     # ADC, so the SDK can call Vertex
#   5. cp .env.workshop.example .env             # then set GOOGLE_CLOUD_PROJECT below
#
# Take-home path instead? Use .env.example — one free AI Studio key, no project.

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=adk-2-tutorial-XXXX
GOOGLE_CLOUD_LOCATION=us-central1

# gemini-flash-latest is an AI-Studio-only alias and 404s on Vertex AI.
ADK_MODEL=gemini-2.5-flash

# Do NOT also set GOOGLE_API_KEY here — a stray key makes ADK ignore Vertex.
